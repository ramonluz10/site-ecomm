{
  "version": 2,
  "builds": [
    { "src": "package.json", "use": "@vercel/next" }
  ],
  "env": {
    "NEXT_PUBLIC_API_URL": "https://api.suaempresa.com"
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.suaempresa.com/api/:path*" }
  ]
}
{
  "version": 3,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/next"
    }
  ],
  "framework": {
    "name": "nextjs"
  }
}
